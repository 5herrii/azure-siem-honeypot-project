// Enrich failed Windows logon attempts with GeoIP data
// Uses Sentinel Watchlist and ipv4_lookup to map attacker IPs to locations

let GeoIPDB_FULL = _GetWatchlist("geoip");

SecurityEvent
| where EventID == 4625
| where isnotempty(IpAddress)
| evaluate ipv4_lookup(
    GeoIPDB_FULL,
    IpAddress,
    network,
    countryname,
    cityname,
    latitude,
    longitude
)
| project
    TimeGenerated,
    AttackerIP = IpAddress,
    Account,
    Computer,
    Country = countryname,
    City = cityname,
    Latitude = latitude,
    Longitude = longitude
| order by TimeGenerated desc
